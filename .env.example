# Copy to .env.local for local dev. Never commit real values.

# Resend (https://resend.com): sends the owner notification.
# With the test sender below, Resend only delivers to the address you signed up with.
RESEND_API_KEY=
NOTIFY_EMAIL=rand@randpierce.com
MAIL_FROM=POP POP Downloads <onboarding@resend.dev>

# Long random string. Generate with: openssl rand -base64 48
DOWNLOAD_SECRET=
