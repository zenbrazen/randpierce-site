# Copy to .env.local for local dev. Never commit real values.

# Resend (https://resend.com): sends the owner notification
RESEND_API_KEY=
NOTIFY_EMAIL=rand@randpierce.com
MAIL_FROM=POP POP Downloads <downloads@randpierce.com>

# Long random strings. Generate each with: openssl rand -base64 48
DOWNLOAD_SECRET=
ADMIN_TOKEN=

# Upstash Redis. The Vercel Marketplace integration sets these automatically
# (KV_REST_API_URL / KV_REST_API_TOKEN, or UPSTASH_REDIS_REST_URL / UPSTASH_REDIS_REST_TOKEN).
KV_REST_API_URL=
KV_REST_API_TOKEN=
